{
  "$schema": "https://unpkg.com/wrangler@4.160.1/config-schema.json",
  "name": "guildhall",
  // Match the already-deployed Worker (created 7 Nov 2026, compatibility_date 2026-11-04).
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./web",
    // /cards/extractor serves web/cards/extractor.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
