# NEAR testnet operator account (the platform owner). Create one in any wallet.
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.near.org
OPERATOR_ACCOUNT=yourname.testnet
OPERATOR_PRIVATE_KEY=ed25519:...

# Filled in by `npm run deploy`
HUB_CONTRACT=hub.yourname.testnet
TOKEN_CONTRACT=usdc.yourname.testnet

# Client account used by post-job / approve (can be the operator for the demo)
CLIENT_ACCOUNT=yourname.testnet
CLIENT_PRIVATE_KEY=ed25519:...

# LLM used by the agent and the cert runner
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5

# Where the cert scoring report is published (used as the cert's score_uri)
SCORE_URI_BASE=https://github.com/scribbler421/agenthub/blob/main/app/out

# NEAR AI Cloud (TEE inference with signed execution proofs)
LLM_PROVIDER=anthropic            # or nearai
NEARAI_CLOUD_API_KEY=sk-...
NEARAI_MODEL=Qwen/Qwen3.8-27B
